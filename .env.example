# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- API ---
API__BOOTSTRAP_API_KEY=change-me-to-a-long-random-string
API__CORS_ORIGINS=["http://localhost:3000"]

# --- Infrastructure ---
DATABASE__URL=postgresql+asyncpg://operator:change-me-db-password@127.0.0.1:5432/operator
REDIS__URL=redis://127.0.0.1:6379/0
# Used by docker-compose to create the database user (must match DATABASE__URL).
OPERATOR_DB_PASSWORD=change-me-db-password
# Only used by scripts/windows/infra.ps1 to initialise a native local Postgres.
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres-superuser

# --- LLM backends (any OpenAI-compatible endpoint; free tiers). Failover follows LLM__PROVIDERS.
LLM__PROVIDERS=["gemini","groq","ollama"]
LLM__BACKENDS__GROQ__BASE_URL=https://api.groq.com/openai/v1
LLM__BACKENDS__GROQ__MODEL=openai/gpt-oss-120b
LLM__BACKENDS__GROQ__API_KEY=
LLM__BACKENDS__GROQ__REQUESTS_PER_MINUTE=30
LLM__BACKENDS__GROQ__TOKENS_PER_MINUTE=8000
LLM__BACKENDS__GEMINI__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM__BACKENDS__GEMINI__MODEL=gemini-2.5-flash
LLM__BACKENDS__GEMINI__API_KEY=
LLM__BACKENDS__GEMINI__REQUESTS_PER_MINUTE=10
LLM__BACKENDS__GEMINI__EXTRA_BODY={"reasoning_effort":"none"}
LLM__BACKENDS__OLLAMA__BASE_URL=http://localhost:11434/v1
LLM__BACKENDS__OLLAMA__MODEL=qwen3.5:9b
LLM__BACKENDS__OLLAMA__REQUIRES_API_KEY=false
LLM__BACKENDS__OLLAMA__REQUESTS_PER_MINUTE=600
LLM__BACKENDS__OLLAMA__MAX_CONCURRENCY=1
LLM__BACKENDS__OLLAMA__TIMEOUT_SECONDS=180

# --- Paths ---
PATHS__COMPANY_CONTEXT_DIR=company_context
PATHS__EVIDENCE_DIR=var/evidence
PATHS__WORKSPACE_DIR=var/workspace

# --- Browser ---
BROWSER__HEADLESS=true

# --- Sandbox systems the operator works in (mock company apps) ---
SANDBOX_PORTAL_URL=http://localhost:8101
SANDBOX_ERP_URL=http://localhost:8102
CREDENTIALS__VENDOR_PORTAL__USERNAME=ap.clerk@acme-buyer.test
CREDENTIALS__VENDOR_PORTAL__PASSWORD=change-me-portal
CREDENTIALS__INTERNAL_ERP__USERNAME=operator
CREDENTIALS__INTERNAL_ERP__PASSWORD=change-me-erp
CREDENTIALS__INTERNAL_ERP_API__USERNAME=api
CREDENTIALS__INTERNAL_ERP_API__PASSWORD=change-me-erp-api-token

# --- Sandbox service settings (read by the sandbox apps) ---
SANDBOX__SESSION_SECRET=change-me-sandbox-session-secret
SANDBOX__PORTAL_USERNAME=ap.clerk@acme-buyer.test
SANDBOX__PORTAL_PASSWORD=change-me-portal
SANDBOX__ERP_USERNAME=operator
SANDBOX__ERP_PASSWORD=change-me-erp
SANDBOX__DATA_DIR=var/sandbox
SANDBOX__ERP_API_TOKEN=change-me-erp-api-token

# --- Chaos (failure injection in the sandbox) ---
CHAOS__ENABLED=false
CHAOS__SEED=42
CHAOS__ERROR_RATE=0.15
CHAOS__SLOW_RATE=0.2
CHAOS__SLOW_MS=1500
CHAOS__RENDER_DELAY_MS=1200
CHAOS__SESSION_MAX_REQUESTS=25
CHAOS__ALT_LABELS=true
CHAOS__DUPLICATE_TRAP=false

# --- Frontend (server-side only; the browser never sees the API key) ---
OPERATOR_API_URL=http://localhost:8000/api/v1
OPERATOR_API_KEY=change-me-to-a-long-random-string
